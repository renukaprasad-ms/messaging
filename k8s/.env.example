# Use addresses reachable FROM the Kubernetes pod, not localhost.
# These defaults match the included PostgreSQL, Redis, and Kafka manifests.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/messaging
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SPRING_JPA_HIBERNATE_DDL_AUTO=update
APP_CORS_ALLOWED_ORIGINS=http://localhost:5100
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_FROM=no-reply@example.com
JWT_ISSUER=messaging
JWT_COOKIE_SECURE=false
# Add other application.yaml environment overrides here as needed.
